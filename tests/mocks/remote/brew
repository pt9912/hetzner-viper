#!/usr/bin/env bash
# Fake Homebrew on the server: remembers taps and formulae in $MOCK_STATE/brew-*.
# MOCK_BREW_FAIL_PKG=<name>: installing that formula fails; MOCK_BREW_FAIL_TAP=<name>: that tap fails.
d="$MOCK_STATE"; touch "$d/brew-taps" "$d/brew-formulae" "$d/brew-trust"
echo "brew $*" >> "$d/brew.log"
add() { grep -qxF -- "$2" "$1" || echo "$2" >> "$1"; }
install_formula() {   # owner/repo/name taps owner/repo first, like the real brew
  [[ "${1##*/}" != "${MOCK_BREW_FAIL_PKG:-}" ]] || { echo "Error: No available formula with the name \"$1\"" >&2; return 1; }
  [[ "$1" != */*/* ]] || add "$d/brew-taps" "${1%/*}"
  add "$d/brew-formulae" "${1##*/}"
}
case "$1" in
  --version) echo 'Homebrew 4.9.0' ;;
  shellenv) echo "export PATH=\"$(dirname "$0"):\$PATH\"" ;;
  tap)
    if (( $# == 1 )); then cat "$d/brew-taps"
    else [[ "$2" != "${MOCK_BREW_FAIL_TAP:-}" ]] || { echo "Error: Failure while executing; git clone" >&2; exit 1; }; add "$d/brew-taps" "$2"; fi ;;
  trust)
    if [[ "$2" == --json=v1 ]]; then
      python3 -c 'import json,sys
e={"taps":[],"formulae":[],"casks":[],"commands":[]}
for l in open(sys.argv[1]):
    k,_,n=l.strip().partition(" ")
    if k: e[{"tap":"taps","formula":"formulae","cask":"casks","command":"commands"}[k]].append(n)
print(json.dumps(e))' "$d/brew-trust"
    else
      [[ "$3" != "${MOCK_BREW_FAIL_TRUST:-}" ]] || { echo "Error: no such $2" >&2; exit 1; }
      add "$d/brew-trust" "${2#--} $3"
    fi ;;
  install) shift; rc=0; for p in "$@"; do [[ "$p" == -* ]] || install_formula "$p" || rc=1; done; exit $rc ;;
  list) for p in "${@: -1}"; do grep -qxF -- "$p" "$d/brew-formulae" && echo "$p 1.0"; done; grep -qxF -- "${*: -1}" "$d/brew-formulae" ;;
  bundle)
    file=$(sed -n 's/^--file=//p' <<<"$(printf '%s\n' "$@")")
    while read -r kind name _; do
      name="${name//\"/}"; name="${name%,}"
      case "$kind" in
        tap)  if [[ "$2" == check ]]; then grep -qxF -- "$name" "$d/brew-taps" || exit 1; else add "$d/brew-taps" "$name"; fi ;;
        brew) if [[ "$2" == check ]]; then grep -qxF -- "${name##*/}" "$d/brew-formulae" || exit 1; else install_formula "$name" || exit 1; fi ;;
      esac
    done < "$file" ;;
esac
