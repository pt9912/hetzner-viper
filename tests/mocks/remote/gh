#!/usr/bin/env bash
# Fake gh on the server: logged in once start.sh sent a token
case "$1 $2" in
  "--version "*) echo 'gh version 2.46.0 (2025-12-13 Ubuntu 2.46.0-4)' ;;
  "auth status") [[ -s "$MOCK_STATE/gh-token" ]] ;;
  # gh api --hostname H user -q ...: login, id and name of the account (MOCK_GH_NONAME: no name set)
  "api "*) printf 'tester\t4242\t%s\n' "$([[ -n "${MOCK_GH_NONAME:-}" ]] || echo 'Test User')" ;;
esac
