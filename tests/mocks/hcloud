#!/usr/bin/env python3
"""Stateful fake of the hcloud CLI. State lives in $MOCK_STATE/hcloud/<kind>/<name>.json."""
import json, os, shutil, subprocess, sys
state = os.path.join(os.environ['MOCK_STATE'], 'hcloud')
args = sys.argv[1:]
with open(os.path.join(os.environ['MOCK_STATE'], 'calls.log'), 'a') as f:
    f.write('hcloud ' + ' '.join(args) + '\n')

def path(kind, name):
    os.makedirs(os.path.join(state, kind), exist_ok=True)
    return os.path.join(state, kind, name + '.json')

def opt_all(flag):
    return [args[i + 1] for i, a in enumerate(args) if a == flag]

def fingerprint(pubfile):
    out = subprocess.run(['ssh-keygen', '-E', 'md5', '-lf', pubfile], capture_output=True, text=True, check=True).stdout
    return out.split()[1].removeprefix('MD5:')

def opt(flag):
    return args[args.index(flag) + 1] if flag in args else None

if os.environ.get('MOCK_HCLOUD_FAIL'):
    print('hcloud: unable to authenticate your token', file=sys.stderr); sys.exit(1)
kind, action = args[0], args[1]

# read-only catalogue (server types, locations, datacenters, images) for preflight.sh
TYPES = {'cx53': {'id': 1, 'cores': 16, 'memory': 32, 'disk': 320, 'architecture': 'x86'},
         'cpx02': {'id': 2, 'cores': 1, 'memory': 1, 'disk': 20, 'architecture': 'x86'},
         'cax11': {'id': 3, 'cores': 2, 'memory': 4, 'disk': 40, 'architecture': 'arm'}}
# Like the real API: per-location availability is part of the server type.
# MOCK_SOLD_OUT=<type>: offered but not orderable; MOCK_DEPRECATED=<type>: deprecated in fsn1
def locations(name):
    sold = os.environ.get('MOCK_SOLD_OUT') == name
    dep = {'announced': '2026-01-01T00:00:00Z', 'unavailable_after': '2027-01-01T00:00:00Z'} if os.environ.get('MOCK_DEPRECATED') == name else None
    return [{'name': 'fsn1', 'available': not sold, 'deprecation': dep}, {'name': 'nbg1', 'available': True, 'deprecation': None}]
IMAGES = {('ubuntu-26.04', 'x86'), ('ubuntu-26.04', 'arm'), ('ubuntu-24.04', 'x86'), ('ubuntu-24.04', 'arm')}
if (kind, action) == ('server-type', 'describe'):
    t = TYPES.get(args[2])
    if not t:
        print('hcloud: server type not found: ' + args[2], file=sys.stderr); sys.exit(1)
    print(json.dumps(dict(t, name=args[2], locations=locations(args[2])))); sys.exit(0)
if (kind, action) == ('location', 'describe'):
    sys.exit(0 if args[2] in ('fsn1', 'nbg1', 'hel1') else 1)
if kind == 'datacenter':   # removed from the real API
    print('hcloud: API functionality was removed (deprecated_api_endpoint)', file=sys.stderr); sys.exit(1)
if (kind, action) == ('image', 'describe'):
    arch = opt('--architecture') or 'x86'
    sys.exit(0 if (args[-1], arch) in IMAGES else 1)
name = opt('--name') if action in ('create',) else (args[2] if len(args) > 2 else None)
if kind in ('ssh-key', 'firewall', 'server'):
    if action == 'list':
        d = os.path.join(state, kind)
        items = [json.load(open(os.path.join(d, f))) for f in sorted(os.listdir(d)) if f.endswith('.json')] if os.path.isdir(d) else []
        cols = (opt_all('-o')[-1].split('=', 1)[1] if opt_all('-o') else 'name').split(',')
        for it in items:
            print('  '.join(str(it.get(c, '-')) for c in cols))
        sys.exit(0)
    p = path(kind, name)
    if action == 'describe':
        if not os.path.exists(p):
            print(f'hcloud: {kind} not found: {name}', file=sys.stderr); sys.exit(1)
        if opt('-o') == 'json':
            if os.environ.get('MOCK_DESCRIBE_FAIL'):
                print('hcloud: temporary failure', file=sys.stderr); sys.exit(1)
            print(open(p).read())
    elif action == 'create':
        data = {'name': name, 'args': args, 'id': 1000 + len(os.listdir(os.path.dirname(p)))}
        import datetime
        data['created'] = datetime.datetime.now(datetime.timezone.utc).strftime('%Y-%m-%dT%H:%M:%S+00:00')
        if kind == 'ssh-key':
            data['fingerprint'] = fingerprint(opt('--public-key-from-file'))
            d = os.path.dirname(p)
            # like the real API: a public key may exist only once per project
            if any(json.load(open(os.path.join(d, f))).get('fingerprint') == data['fingerprint'] for f in os.listdir(d) if f.endswith('.json')):
                print('hcloud: SSH key with the same fingerprint already exists (uniqueness_error)', file=sys.stderr); sys.exit(1)
        if kind == 'firewall':
            data['rules'] = []
        if kind == 'server':
            data['ip'] = '203.0.113.%d' % (10 + data['id'] % 200)
            ud = opt('--user-data-from-file')
            shutil.copy(ud, p.replace('.json', '.user-data'))
        json.dump(data, open(p, 'w'))
    elif action == 'add-rule':
        # stored like the real API: direction, protocol, port (tcp/udp only), source_ips
        data = json.load(open(p))
        data['rules'].append({'direction': opt('--direction'), 'protocol': opt('--protocol'), 'port': opt('--port'),
                              'source_ips': (opt('--source-ips') or '').split(','), 'destination_ips': [], 'description': None})
        json.dump(data, open(p, 'w'))
    elif action == 'ip' and kind == 'server':
        if not os.path.exists(p):
            sys.exit(1)
        print(json.load(open(p))['ip'])
    elif action == 'delete':
        os.remove(p)
    else:
        print('unsupported mock call: ' + ' '.join(args), file=sys.stderr); sys.exit(2)
else:
    print('unsupported mock call: ' + ' '.join(args), file=sys.stderr); sys.exit(2)
