#!/usr/bin/env python3
"""Stateful fake of the hcloud CLI. State lives in $MOCK_STATE/hcloud/<kind>/<name>.json."""
import json, os, shutil, subprocess, sys
state = os.path.join(os.environ['MOCK_STATE'], 'hcloud')
args = sys.argv[1:]
with open(os.path.join(os.environ['MOCK_STATE'], 'calls.log'), 'a') as f:
    f.write('hcloud ' + ' '.join(args) + '\n')

def path(kind, name):
    os.makedirs(os.path.join(state, kind), exist_ok=True)
    return os.path.join(state, kind, name + '.json')

def opt_all(flag):
    return [args[i + 1] for i, a in enumerate(args) if a == flag]

def fingerprint(pubfile):
    out = subprocess.run(['ssh-keygen', '-E', 'md5', '-lf', pubfile], capture_output=True, text=True, check=True).stdout
    return out.split()[1].removeprefix('MD5:')

def opt(flag):
    return args[args.index(flag) + 1] if flag in args else None

if os.environ.get('MOCK_HCLOUD_FAIL'):
    print('hcloud: unable to authenticate your token', file=sys.stderr); sys.exit(1)
kind, action = args[0], args[1]
name = opt('--name') if action in ('create',) else (args[2] if len(args) > 2 else None)
if kind in ('ssh-key', 'firewall', 'server'):
    if action == 'list':
        d = os.path.join(state, kind)
        items = [json.load(open(os.path.join(d, f))) for f in sorted(os.listdir(d)) if f.endswith('.json')] if os.path.isdir(d) else []
        cols = (opt_all('-o')[-1].split('=', 1)[1] if opt_all('-o') else 'name').split(',')
        for it in items:
            print('  '.join(str(it.get(c, '-')) for c in cols))
        sys.exit(0)
    p = path(kind, name)
    if action == 'describe':
        if not os.path.exists(p):
            print(f'hcloud: {kind} not found: {name}', file=sys.stderr); sys.exit(1)
        if opt('-o') == 'json':
            if os.environ.get('MOCK_DESCRIBE_FAIL'):
                print('hcloud: temporary failure', file=sys.stderr); sys.exit(1)
            print(open(p).read())
    elif action == 'create':
        data = {'name': name, 'args': args, 'id': 1000 + len(os.listdir(os.path.dirname(p)))}
        if kind == 'ssh-key':
            data['fingerprint'] = fingerprint(opt('--public-key-from-file'))
            d = os.path.dirname(p)
            # like the real API: a public key may exist only once per project
            if any(json.load(open(os.path.join(d, f))).get('fingerprint') == data['fingerprint'] for f in os.listdir(d) if f.endswith('.json')):
                print('hcloud: SSH key with the same fingerprint already exists (uniqueness_error)', file=sys.stderr); sys.exit(1)
        if kind == 'firewall':
            data['rules'] = []
        if kind == 'server':
            data['ip'] = '203.0.113.%d' % (10 + data['id'] % 200)
            ud = opt('--user-data-from-file')
            shutil.copy(ud, p.replace('.json', '.user-data'))
        json.dump(data, open(p, 'w'))
    elif action == 'add-rule':
        data = json.load(open(p)); data['rules'].append(args[3:]); json.dump(data, open(p, 'w'))
    elif action == 'ip' and kind == 'server':
        if not os.path.exists(p):
            sys.exit(1)
        print(json.load(open(p))['ip'])
    elif action == 'delete':
        os.remove(p)
    else:
        print('unsupported mock call: ' + ' '.join(args), file=sys.stderr); sys.exit(2)
else:
    print('unsupported mock call: ' + ' '.join(args), file=sys.stderr); sys.exit(2)
