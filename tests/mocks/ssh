#!/usr/bin/env bash
# Fake ssh. Like real ssh, everything after the host is joined into ONE string that the
# remote shell parses again, and without -n stdin is consumed. `bash -s ...` scripts and
# the readiness probe run locally in a sandbox.
echo "ssh $*" >> "$MOCK_STATE/calls.log"
args=("$@"); i=0; no_stdin=0
while (( i < ${#args[@]} )) && [[ "${args[i]}" != hetzner-* ]]; do
  [[ "${args[i]}" == -n ]] && no_stdin=1
  i=$((i+1))
done
remote="${args[*]:i+1}"
consume() { (( no_stdin )) || cat >/dev/null; }
[[ -z "${MOCK_SSH_DOWN:-}" ]] || { consume; echo 'ssh: connect to host 203.0.113.10 port 22: Connection timed out' >&2; exit 255; }
[[ -z "${MOCK_SSH_HOSTKEY_FAIL:-}" ]] || { consume; echo 'Host key verification failed.' >&2; exit 255; }
# connection like another device (only the host CA is trusted): MOCK_CA_FAIL = expired certificate
if [[ "$*" == *known_hosts_hetzner_claude_ca* && -n "${MOCK_CA_FAIL:-}" ]]; then
  consume; echo 'Certificate invalid: expired' >&2; echo 'Host key verification failed.' >&2; exit 255
fi
export HOME="$MOCK_STATE/remote-home" VIPER_TMP_DIRS="$MOCK_STATE/remote-tmp"
mkdir -p "$HOME" "$VIPER_TMP_DIRS"
case "$remote" in
  # readiness probe: fake cloud-init/docker, sandboxed marker file
  "cloud-init status"*)
    consume
    PATH="$(dirname "$0")/remote:$PATH" bash -c "${remote//\/var\/tmp\/claude-ready/$MOCK_STATE/claude-ready}"
    exit $? ;;
  *install.sh*)
    consume
    [[ -z "${MOCK_INSTALL_FAIL:-}" ]] || exit 1
    touch "$MOCK_STATE/claude-ready" ;;
  # Claude token login: run it for real in the sandbox home (stdin = token)
  *viper/claude.env*) (( no_stdin )) && exec </dev/null; bash -c "$remote"; exit $? ;;
  "gh auth login"*) if (( no_stdin )); then : > "$MOCK_STATE/gh-token"; else cat > "$MOCK_STATE/gh-token"; fi ;;
  # host key read over a CA-verified connection (pin_from_server)
  "cat /etc/ssh/ssh_host_ed25519_key.pub") consume; cat "$MOCK_STATE/remote-hostkey.pub" 2>/dev/null ;;
  "bash -s"*) (( no_stdin )) && exec </dev/null; PATH="$(dirname "$0")/remote:$PATH" bash -c "$remote"; exit $? ;;
  *) consume ;;
esac
exit 0
