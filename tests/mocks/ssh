#!/usr/bin/env bash
# Fake ssh. Like real ssh, everything after the host is joined into ONE string that the
# remote shell parses again, and without -n stdin is consumed. `bash -s ...` scripts and
# the readiness probe run locally in a sandbox.
echo "ssh $*" >> "$MOCK_STATE/calls.log"
args=("$@"); i=0; no_stdin=0
while (( i < ${#args[@]} )) && [[ "${args[i]}" != hetzner-* ]]; do
  [[ "${args[i]}" == -n ]] && no_stdin=1
  [[ "${args[i]}" == -t ]] && echo "ssh: terminal requested" >> "$MOCK_STATE/calls.log"
  i=$((i+1))
done
remote="${args[*]:i+1}"
consume() { (( no_stdin )) || cat >/dev/null; }
[[ -z "${MOCK_SSH_DOWN:-}" ]] || { consume; echo 'ssh: connect to host 203.0.113.10 port 22: Connection timed out' >&2; exit 255; }
[[ -z "${MOCK_SSH_HOSTKEY_FAIL:-}" ]] || { consume; echo 'Host key verification failed.' >&2; exit 255; }
[[ -z "${MOCK_SSH_AUTH_FAIL:-}" ]] || { consume; echo 'builder@203.0.113.10: Permission denied (publickey).' >&2; exit 255; }
# connection like another device (only the host CA is trusted): MOCK_CA_FAIL = expired certificate
if [[ "$*" == *known_hosts_hetzner_claude_ca* && -n "${MOCK_CA_FAIL:-}" ]]; then
  consume; echo 'Certificate invalid: expired' >&2; echo 'Host key verification failed.' >&2; exit 255
fi
export HOME="$MOCK_STATE/remote-home" VIPER_TMP_DIRS="$MOCK_STATE/remote-tmp" VIPER_REBOOT_FILE="$MOCK_STATE/reboot-required" \
  VIPER_CLOUD_RESULT="$MOCK_STATE/cloud-result.json" VIPER_SWAPFILE="$MOCK_STATE/remote-swapfile" \
  VIPER_FSTAB="$MOCK_STATE/remote-fstab" VIPER_SYSCTL_D="$MOCK_STATE/remote-sysctl.d" VIPER_MEMINFO="$MOCK_STATE/meminfo"
mkdir -p "$HOME" "$VIPER_TMP_DIRS" "$VIPER_SYSCTL_D"
[[ -e "$VIPER_MEMINFO" ]] || printf 'MemTotal:        7800000 kB\n' > "$VIPER_MEMINFO"
case "$remote" in
  # readiness probe: fake cloud-init/docker, sandboxed marker file
  "cloud-init status"*)
    consume
    PATH="$(dirname "$0")/remote:$PATH" bash -c "${remote//\/var\/tmp\/claude-ready/$MOCK_STATE/claude-ready}"; rc=$?
    # the pending reboot happens right after this probe, unless the test keeps the flag
    [[ -f "$MOCK_STATE/reboot-required.keep" ]] || rm -f "$MOCK_STATE/reboot-required"
    exit $rc ;;
  # Homebrew's installer (MOCK_BREW_FAIL: it fails); must come before Claude's install.sh
  *Homebrew/install*) consume; [[ -z "${MOCK_BREW_FAIL:-}" ]] || { echo 'Error: Failed to download'; exit 1; }
    # the installer puts brew where common.sh expects it (VIPER_BREW)
    [[ -e "$VIPER_BREW" ]] || { mkdir -p "$(dirname "$VIPER_BREW")"; ln -s "$(dirname "$0")/remote/brew" "$VIPER_BREW"; } ;;
  # code-server's installer (MOCK_CODE_SERVER_FAIL: it fails); before Claude's install.sh
  *code-server.dev/install.sh*) consume; [[ -z "${MOCK_CODE_SERVER_FAIL:-}" ]] || { echo 'Error: no .deb for this system'; exit 1; }
    touch "$MOCK_STATE/code-server-installed" ;;
  *install.sh*)
    consume
    [[ -z "${MOCK_INSTALL_FAIL:-}" ]] || exit 1
    # MOCK_INSTALL_FAIL_TIMES=N: the first N attempts fail (rate limit), then it works
    if [[ -n "${MOCK_INSTALL_FAIL_TIMES:-}" ]]; then
      n=$(cat "$MOCK_STATE/install-attempts" 2>/dev/null || echo 0); echo $((n + 1)) > "$MOCK_STATE/install-attempts"
      (( n >= MOCK_INSTALL_FAIL_TIMES )) || { echo 'curl: (22) The requested URL returned error: 429' >&2; exit 22; }
    fi
    touch "$MOCK_STATE/claude-ready" ;;
  # Claude token login: run it for real in the sandbox home (stdin = token)
  *viper/claude.env*) (( no_stdin )) && exec </dev/null; bash -c "$remote"; exit $? ;;
  # code-server config (stdin = config.yaml) and its systemd unit: run it in the sandbox home
  *code-server/config.yaml*) (( no_stdin )) && exec </dev/null; PATH="$(dirname "$0")/remote:$PATH" bash -c "$remote"; exit $? ;;
  # creating the workspace (sudo install -d ...) and recording it: run it in the sandbox
  "sudo install -d"*) consume; PATH="$(dirname "$0")/remote:$PATH" bash -c "$remote"; exit $? ;;
  "gh auth login"*) [[ -z "${MOCK_GH_LOGIN_FAIL:-}" ]] || { consume; echo 'error validating token' >&2; exit 1; }
    if (( no_stdin )); then : > "$MOCK_STATE/gh-token"; else cat > "$MOCK_STATE/gh-token"; fi ;;
  # host key read over a CA-verified connection (pin_from_server)
  "cat /etc/ssh/ssh_host_ed25519_key.pub") consume; cat "$MOCK_STATE/remote-hostkey.pub" 2>/dev/null ;;
  # MOCK_SSH_SKIP_SCRIPT: ssh succeeds but the remote script does not run (e.g. .bashrc exits)
  "bash -s"*) [[ -z "${MOCK_SSH_SKIP_SCRIPT:-}" ]] || { consume; exit 0; }
              (( no_stdin )) && exec </dev/null; PATH="$(dirname "$0")/remote:$PATH" bash -c "$remote"; exit $? ;;
  *) consume ;;
esac
exit 0
