#!/usr/bin/env python3
"""Fake HTTP APIs: Cloudflare DNS records (state: $MOCK_STATE/cf.json), DNS over HTTPS,
GitHub and an Anthropic-compatible Messages API."""
import json, os, sys, urllib.parse
args = sys.argv[1:]
sf = os.path.join(os.environ['MOCK_STATE'], 'cf.json')
with open(os.path.join(os.environ['MOCK_STATE'], 'calls.log'), 'a') as f:
    f.write('curl ' + ' '.join(args) + '\n')
recs = json.load(open(sf)) if os.path.exists(sf) else []
# Anthropic Messages API of another provider (preflight.sh): like curl -w '\n%{http_code}'
llm = [a for a in args if a.endswith('/v1/messages')]
if llm:
    hdrs = [args[i + 1] for i, a in enumerate(args) if a == '-H']
    auth = ''.join(open(h[1:]).read() if h.startswith('@') else h for h in hdrs)
    model = json.loads(args[args.index('--data') + 1])['model']
    if 'Authorization: Bearer ' not in auth or os.environ.get('MOCK_LLM_BAD_TOKEN'):
        code, out = 401, {'type': 'error', 'error': {'type': 'authentication_error', 'message': 'invalid api key'}}
    elif os.environ.get('MOCK_LLM_BAD_MODEL') == model:
        code, out = 404, {'type': 'error', 'error': {'type': 'not_found_error', 'message': f"model '{model}' not found"}}
    else:
        code, out = 200, {'type': 'message', 'content': [{'type': 'text', 'text': 'OK'}]}
    print(json.dumps(out) + ('\n' + str(code) if '-w' in args else '')); sys.exit(0)
# DNS over HTTPS (check.sh): answers from the fake Cloudflare zone; MOCK_DNS_STALE: no answer yet
doh = [a for a in args if a.startswith(('https://cloudflare-dns.com/', 'https://dns.google/'))]
if doh:
    name = urllib.parse.parse_qs(urllib.parse.urlparse(doh[0]).query)['name'][0]
    if urllib.parse.parse_qs(urllib.parse.urlparse(doh[0]).query).get('type') == ['SOA']:
        print(json.dumps({'Status': 0, 'Answer': [{'type': 6, 'data': 'ns.test.invalid. dns.test.invalid. 1 10000 2400 604800 1800'}]})); sys.exit(0)
    ans = [] if os.environ.get('MOCK_DNS_STALE') else [{'type': 1, 'data': r['content']} for r in recs if r['name'] == name]
    print(json.dumps({'Status': 0 if ans else 3, 'Answer': ans})); sys.exit(0)
# like the real API with -f: no valid bearer header (or MOCK_CF_FAIL) -> HTTP error, exit 22
headers = [args[i + 1] for i, a in enumerate(args) if a == '-H']
auth = [open(h[1:]).read() if h.startswith('@') else h for h in headers]
if os.environ.get('MOCK_CF_FAIL') or not any(a.startswith('Authorization: Bearer ') for a in auth):
    print('curl: (22) The requested URL returned error: 403', file=sys.stderr); sys.exit(22)
method = args[args.index('-X') + 1] if '-X' in args else 'GET'
# GitHub API (preflight.sh): MOCK_GH_BAD rejects the token, MOCK_GH_SCOPES fakes a classic
# token's scopes, MOCK_GH_NOREPO denies repository access
gh = [a for a in args if a.startswith('https://api.github.com/')]
if gh:
    if os.environ.get('MOCK_GH_BAD'):
        print('curl: (22) The requested URL returned error: 401', file=sys.stderr); sys.exit(22)
    if '/repos/' in gh[0] and os.environ.get('MOCK_GH_NOREPO'):
        print('curl: (22) The requested URL returned error: 404', file=sys.stderr); sys.exit(22)
    if '-D' in args:
        with open(args[args.index('-D') + 1], 'w') as h:
            h.write('HTTP/2 200\r\n' + ('x-oauth-scopes: ' + os.environ['MOCK_GH_SCOPES'] + '\r\n' if os.environ.get('MOCK_GH_SCOPES') else ''))
    print(json.dumps({'login': 'tester'})); sys.exit(0)
url = [a for a in args if a.startswith('https://')][0]
data = json.loads(args[args.index('--data') + 1]) if '--data' in args else None
u = urllib.parse.urlparse(url)
rid = u.path.rstrip('/').split('/')[-1] if not u.path.endswith('dns_records') else None
if '/dns_records' not in u.path:   # GET /zones/<id> (preflight.sh)
    print(json.dumps({'success': True, 'result': {'id': rid, 'name': os.environ.get('MOCK_CF_ZONE', 'test.invalid')}})); sys.exit(0)
def out(result):
    json.dump(recs, open(sf, 'w'))
    print(json.dumps({'success': True, 'result': result}))
if method == 'GET':
    q = urllib.parse.parse_qs(u.query)
    print(json.dumps({'success': True, 'result': [r for r in recs if r['name'] == q['name'][0]]}))
elif method == 'POST':
    data['id'] = 'rec%d' % (len(recs) + 1); recs.append(data); out(data)
elif method == 'PUT':
    recs[:] = [dict(data, id=rid) if r['id'] == rid else r for r in recs]; out(data)
elif method == 'DELETE':
    recs[:] = [r for r in recs if r['id'] != rid]; out({'id': rid})
