# Copy to groups/<group>.env; the file name is the name of the group (and of the NATS group).
# The machines named here are started and stopped together:
#   viper up --group <group>      viper down --group <group>
#   viper check --group <group>   viper ssh --group <group> --cmd 'uptime'
# The first machine with NATS becomes the NATS server of a new group.
GROUP_MACHINES=alpha,beta
# Settings for all machines of the group; machines/<machine>.env.local overrides them.
# Keep tokens out of this file (like in machines/): it should not be readable by others.
NATS_ENABLED=true
# NATS_MCP=true
# NATS_MCP_PUSH_FROM=
# NATS_MCP_TOPICS=build,alerts
# NATS_MCP_AUTOALLOW=off
# Each machine may have its own SERVER_TYPE, in machines/<machine>.env.local
