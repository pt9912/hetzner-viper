SERVER_PREFIX=claude

# Cloud provider: hetzner (default) or aws. The settings below have the defaults of the provider.
# PROVIDER=hetzner

# Hetzner: https://www.hetzner.com/de/cloud/regular-performance/  cpx02 cpx22 cpx32 cpx42 cpx52 cpx62
#   SERVER_TYPE=cpx32  SERVER_LOCATION=fsn1  SERVER_IMAGE=ubuntu-26.04
# AWS: instance type, region (or zone, e.g. eu-central-1b) and ubuntu-<version> or an AMI ID
#   SERVER_TYPE=t3.large  SERVER_LOCATION=eu-central-1  SERVER_IMAGE=ubuntu-24.04
#   AWS_PROFILE, AWS_SUBNET_ID, AWS_VPC_ID and AWS_ROOT_GB (size of the root disk, default 50) are optional;
#   the credentials come from the AWS credentials chain (aws login, SSO, keys)
# SERVER_TYPE=
# SERVER_LOCATION=
# SERVER_IMAGE=
# Machines are addressed as <SERVER_PREFIX>-<machine>.<DNS_DOMAIN> (A record managed in Cloudflare)
DNS_DOMAIN=
SSH_KEY="$HOME/.ssh/hetzner-build"
# SSH from anywhere (iPad / mobile). Protected by public-key-only sshd configuration.
# Narrow this to your networks if possible.
SSH_ALLOWED_CIDRS=0.0.0.0/0,::/0

# Optional: public SSH key from iPad, one OpenSSH public key per file
IPAD_SSH_PUBLIC_KEY_FILE=

# Install Homebrew (brew) on the server: 1 (default) or 0 (saves 1-2 minutes per new server).
# Values in these files take precedence over variables exported in the shell.
# VIPER_HOMEBREW=1
# Homebrew, separated by spaces, applied in this order: taps (extra package sources), trust
# (brew trust for third-party taps or formulae), formulae (tools). A tap is "owner/repo" (on
# GitHub) or "owner/repo=URL". Trust: "owner/repo" = the whole tap, "owner/repo/name" = one
# formula, or "cask:…" / "command:…". A formula is "name" or "owner/repo/name".
# Installing owner/repo/name trusts that one formula already; VIPER_BREW_TRUST is for
# formulae installed by short name, casks, external commands, or a whole tap.
# VIPER_BREWFILE=1 also applies a Brewfile of the cloned repository (brew bundle). It is Ruby
# code from the repository and its trusted: entries change Homebrew's trust store.
# Lists: entries separated by spaces or line breaks, the whole value in double quotes.
# VIPER_BREW_TAPS="hashicorp/tap"
# VIPER_BREW_TRUST=""
# VIPER_BREWFILE=0
# VIPER_BREW_PACKAGES="ripgrep fd hashicorp/tap/terraform"

# Optional: swap file on the server (a safety net against the OOM killer, off by default):
# a factor of the server's RAM (1 = as much as RAM, 0.5 = half; 0.1 to 4) or a size (4G, 512M).
# VIPER_SWAP=1

# Directory on the server that holds the cloned repositories (deleted with the server)
WORKSPACE_DIR=/Development

# Credentials (or export them in your shell instead; never commit .env.local)
# HCLOUD_TOKEN=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ZONE_ID=

# Optional: author of git commits made on the server. Without them, VIPER_GH_TOKEN (below)
# supplies the GitHub account's name and noreply address; with neither, commits there fail.
# VIPER_GIT_USER_NAME="Your Name"
# VIPER_GIT_USER_EMAIL=you@example.com

# Optional: code-server (VS Code in the browser) on the server, on 127.0.0.1:8080 only; reach it
# with an SSH tunnel: ssh -L 8080:127.0.0.1:8080 hetzner-<server>. The password needs 12+
# characters without spaces; quote it if it has special characters.
# VIPER_CODE_SERVER=1
# VIPER_CODE_SERVER_PASSWORD=

# Optional: GitHub personal access token for gh and git over HTTPS on the server.
# Prefer a fine-grained, repo-scoped, short-lived token per machine (machines/<machine>.env.local).
# Deliberately not GH_TOKEN: a token exported for your local gh is never copied to a server.
# VIPER_GH_TOKEN=
# VIPER_GH_HOST=github.com

# Optional: Claude Code login on the server without /login. A long-lived token for your
# Claude subscription (Pro, Max, Team, Enterprise), created once with `claude setup-token`
# (valid for one year; usage counts against the subscription, not API credits).
# Deliberately not CLAUDE_CODE_OAUTH_TOKEN: a token exported locally is never copied.
# VIPER_CLAUDE_TOKEN=

# Optional instead: another model behind an Anthropic-compatible API (Ollama's cloud, a vLLM
# server, a gateway). Usage is billed by that provider. Not together with VIPER_CLAUDE_TOKEN.
# Ollama cloud: base URL https://ollama.com, token = Ollama API key (ollama.com/settings/keys)
# VIPER_ANTHROPIC_BASE_URL=https://ollama.com
# VIPER_ANTHROPIC_AUTH_TOKEN=
# VIPER_CLAUDE_MODEL=
# Context window Claude Code should assume for that model (tokens), e.g. 1048576
# VIPER_CLAUDE_MAX_CONTEXT_TOKENS=
