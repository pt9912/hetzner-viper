# Copy to machines/<machine>.env.local; values override .env.local for that machine.
# Cloned on first start into $WORKSPACE_DIR/<repo-name>
REPO_URL=
# REPO_BRANCH=
# Private repos over SSH: a dedicated read-only deploy key (private key file)
# GIT_DEPLOY_KEY_FILE=
# GitHub token only for this machine's repository (fine-grained PAT, overrides .env.local)
# VIPER_GH_TOKEN=
# Claude subscription token for this machine only (claude setup-token)
# VIPER_CLAUDE_TOKEN=
# or another model for this machine (see .env.local.example)
# VIPER_ANTHROPIC_BASE_URL=https://ollama.com
# VIPER_ANTHROPIC_AUTH_TOKEN=
# VIPER_CLAUDE_MODEL=
# Where and on what this machine runs: the cloud and its server type, location and image. The values
# of each provider are in .env.local.example; anything not set here comes from .env.local.
# PROVIDER=hetzner
# SERVER_TYPE=
# SERVER_LOCATION=
# SERVER_IMAGE=
# Provider settings: AWS_PROFILE, AWS_SUBNET_ID, AWS_VPC_ID, AWS_ROOT_GB; GCP_PROJECT, GCP_NETWORK,
# GCP_SUBNET, GCP_ROOT_GB; AZURE_SUBSCRIPTION_ID, AZURE_RESOURCE_GROUP, AZURE_SUBNET_ID, AZURE_ROOT_GB
# DNS name of this machine: cloudflare (default), or none for no DNS record (no Cloudflare, no domain)
# DNS_PROVIDER=cloudflare
# Networks that may reach SSH (port 22)
# SSH_ALLOWED_CIDRS=
# VIPER_HOMEBREW=0
# VIPER_BREW_TAPS=
# VIPER_BREW_TRUST=
# VIPER_BREW_PACKAGES=
