# Copy to machines/<machine>.env.local; values override .env.local for that machine.
# Cloned on first start into $WORKSPACE_DIR/<repo-name>
REPO_URL=
# REPO_BRANCH=
# Private repos over SSH: a dedicated read-only deploy key (private key file)
# GIT_DEPLOY_KEY_FILE=
# GitHub token only for this machine's repository (fine-grained PAT, overrides .env.local)
# GH_TOKEN=
# SERVER_TYPE=
