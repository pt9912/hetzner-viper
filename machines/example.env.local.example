# Copy to machines/<machine>.env.local; values override .env.local for that machine.
# Cloned on first start into $WORKSPACE_DIR/<repo-name>
REPO_URL=
# REPO_BRANCH=
# Private repos over SSH: a dedicated read-only deploy key (private key file)
# GIT_DEPLOY_KEY_FILE=
# GitHub token only for this machine's repository (fine-grained PAT, overrides .env.local)
# VIPER_GH_TOKEN=
# Claude subscription token for this machine only (claude setup-token)
# VIPER_CLAUDE_TOKEN=
# or another model for this machine (see .env.local.example)
# VIPER_ANTHROPIC_BASE_URL=https://ollama.com
# VIPER_ANTHROPIC_AUTH_TOKEN=
# VIPER_CLAUDE_MODEL=
# SERVER_TYPE=
